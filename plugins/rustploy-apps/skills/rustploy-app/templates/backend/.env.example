# Copie para `.env` (que NUNCA é commitado) para rodar local.
# Em produção estas variáveis vêm do rustploy: DATABASE_URL do projeto,
# JWT_SECRET e ADMIN_PASSWORD de secrets, o resto do serviço `api`.
DATABASE_URL=postgres://app:app@localhost:5432/app
BIND_ADDRESS=0.0.0.0:8080
APP_ENV=development
RUST_LOG=info,tower_http=info
JWT_SECRET=troque-por-uma-string-longa-so-para-desenvolvimento-local
JWT_TTL_HOURS=8
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=senha-local-de-teste
